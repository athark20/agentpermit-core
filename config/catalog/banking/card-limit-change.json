      "cardId",
      "newLimit",
      "currency"
    ],
    "properties": {
      "cardId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 140
      },
      "newLimit": {
        "type": "number",
        "minimum": 0
      },
      "currency": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3
      }
    }
  }
}
