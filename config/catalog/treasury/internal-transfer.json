{
  "actionId": "Treasury.Transfer.Internal",
  "displayName": "Move funds between company accounts",
  "domain": "Treasury",
  "risk": "Financial",
  "consequenceTier": "CRITICAL",
  "targetSystem": "TREASURY",
  "requestSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "fromAccount",
      "toAccount",
      "amount",
      "currency"
    ],
    "properties": {
      "fromAccount": {
        "type": "string",
        "minLength": 1,
        "maxLength": 140
      },
      "toAccount": {
        "type": "string",
        "minLength": 1,
        "maxLength": 140
      },
      "amount": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 100000000
      },
      "currency": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3
      }
    }
  }
}
