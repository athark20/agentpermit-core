{
  "actionId": "JournalEntry.Post",
  "displayName": "Post a general-ledger journal entry",
  "domain": "Finance",
  "risk": "Financial",
  "consequenceTier": "HIGH",
  "targetSystem": "ERP_FINANCE",
  "requestSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "entryRef",
      "debitAccount",
      "creditAccount",
      "amount",
      "currency"
    ],
    "properties": {
      "entryRef": {
        "type": "string",
        "minLength": 1,
        "maxLength": 140
      },
      "debitAccount": {
        "type": "string",
        "minLength": 1,
        "maxLength": 140
      },
      "creditAccount": {
        "type": "string",
        "minLength": 1,
        "maxLength": 140
      },
      "amount": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 100000000
      },
      "currency": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3
      }
    }
  }
}
