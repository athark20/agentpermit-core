      "description": {
        "type": "string",
        "minLength": 3,
        "maxLength": 500
      },
      "estimatedAmount": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "currency": {
        "type": "string",
        "minLength": 3,
        "maxLength": 3
      }
    }
  }
}
