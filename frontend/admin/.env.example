# AgentPermit admin SPA — copy to .env.local and fill in for local dev.
# All values come from the Entra app registration + the gateway URL; nothing is hard-coded.

# Entra tenant (directory) id
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# The SPA's own Entra app registration (Application/client id)
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Delegated scope exposed by the gateway API app, e.g. api://<gateway-app-id>/access_as_user
VITE_API_SCOPE=api://33333333-3333-3333-3333-333333333333/access_as_user

# Gateway base URL the admin endpoints live on (Container App FQDN)
VITE_API_BASE=https://YOUR_GATEWAY_FQDN

# Deployment environment shown as a badge (DEV | UAT | PROD)
VITE_ENVIRONMENT=DEV

# Platform version shown in the sidebar footer
VITE_PLATFORM_VERSION=1.0.0

# Customer / tenant label shown in the top bar
VITE_CUSTOMER_NAME=AgentPermit DEV

# Control-plane admin identity — must match the gateway's AdminAuth section. Used only to hide
# admin-only surfaces (e.g. Your plan / licence management) from non-admins; authorization is
# always enforced server-side. Defaults to the app role "Admin.Access" if unset.
# VITE_ADMIN_ROLE=Admin.Access
# VITE_ADMIN_GROUP_ID=00000000-0000-0000-0000-000000000000
