{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Persistence": {
    "Provider": "InMemory",
    "SqlConnectionString": "",
    "BusinessSqlConnectionString": ""
  },

  "Simulator": {
    "BaseUrl": "http://localhost:5201",
    "RefundPath": "/api/simulator/refunds",
    "ExecutionKey": ""
  },

  "Approval": {
    "ExpiryHours": 24
  },

  "Receipts": {
    "SigningKeyId": ""
  },

  "Admin": {
    "ApiKey": "",
    "HeaderName": "X-Admin-Key"
  },

  "License": {
    "Enforce": false,
    "PublicKeyPem": "",
    "Token": ""
  },

  "Security": {
    "EnforceIdentityBinding": false,
    "IdentityHeader": "X-Agent-Client-Id",
    "ApimOriginHeader": "X-APIM-Origin",
    "ApimSharedSecret": "",
    "AllowBodyAssertedAgentIdentity": true,
    "AgentAuth": {
      "Authority": "",
      "Audience": "",
      "Required": false
    }
  },

  "Teams": {
    "WebhookUrl": "",
    "ApprovalsBaseUrl": "https://YOUR_APIM.azure-api.net/agentpermit",
    "ConsoleBaseUrl": "",
    "AllowWorkflowDecisions": false
  },

  "Policy": {
    "RequireSecondApprover": false,
    "ChangeExpiryDays": 7,
    "Snapshot": {
      "SnapshotPath": "seed/policy-snapshot.json",
      "VerifyHash": false
    }
  },

  "Registry": {
    "ActionDefinitionFiles": [
      "seed/first-action.json",
      "seed/finance/vendor-lookup.json",
      "seed/finance/invoice-lookup.json",
      "seed/finance/invoice-approve.json",
      "seed/finance/payment-issue.json",
      "seed/finance/vendor-update-bank.json"
    ],
    "ActionDefinitionDirectories": [
      "seed/catalog"
    ],
    "Agents": [
      {
        "AgentId": "copilot-refund-demo",
        "DisplayName": "AgentPermit Refund Demo",
        "Enabled": true,
        "EntraClientId": "11111111-1111-1111-1111-111111111111"
      }
    ]
  }
}
