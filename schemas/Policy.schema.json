{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpermit.local/schemas/policy.schema.json",
  "title": "AgentPermit Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policyCode",
    "version",
    "appliesTo",
    "conditions",
    "decision"
  ],
  "properties": {
    "policyCode": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 50
    },
    "appliesTo": {
      "type": "object",
      "required": [
        "actionId"
      ],
      "properties": {
        "actionId": {
          "type": "string",
          "maxLength": 200
        },
        "agentId": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "field",
          "operator",
          "value"
        ],
        "properties": {
          "field": {
            "type": "string",
            "maxLength": 200
          },
          "operator": {
            "enum": [
              "equals",
              "notEquals",
              "greaterThan",
              "greaterThanOrEqual",
              "lessThan",
              "lessThanOrEqual",
              "in",
              "notIn",
              "exists"
            ]
          },
          "value": {},
          "aggregate": {
            "description": "When present, 'field' is aggregated over a window of recent requests (including this one) instead of read from this request alone. Yields a number, so use an ordering or equality operator.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "function",
              "window"
            ],
            "properties": {
              "function": {
                "enum": [
                  "sum",
                  "count",
                  "distinct",
                  "max"
                ]
              },
              "window": {
                "description": "ISO-8601 duration look-back, e.g. PT1H, PT24H, P7D (max P366D).",
                "type": "string",
                "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+(\\.\\d+)?S)?)?$"
              },
              "groupBy": {
                "description": "Fields whose values must equal this request's for a prior request to count: agentId, rootAgentId, initiatingUserId, or any request parameter.",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]{1,100}$"
                }
              },
              "actions": {
                "description": "Action ids to aggregate across. Omit to use the rule's own action.",
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "scope": {
                "description": "committed (default): requests that ran or are pending. all: every request, including denials.",
                "enum": [
                  "committed",
                  "all"
                ]
              }
            }
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "ALLOW",
            "DENY",
            "REQUIRE_APPROVAL"
          ]
        },
        "approverRoles": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    }
  }
}